# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Documented for the AI Studio applet convention, but no code in this
# repo currently reads process.env.APP_URL. Kept as a placeholder — wire it up
# or drop the block once there is a real consumer.
# APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional. Auth for the GitHub REST/Search calls behind the repo
# sync (src/lib/githubRepo.ts, api/github/*) and the GitHub Stars ranking
# (api/github/top-starred.ts). Without it, unauthenticated rate limits apply and
# the ranking answers 401 (MISSING_API_KEY).
# GITHUB_TOKEN="..."

# TRANSLATION_MODEL: Optional. Gemini model id for the description translation
# proxy (api/github/translate-descriptions.ts). Defaults to gemini-2.0-flash.
# TRANSLATION_MODEL="..."

# PIXABAY_API_KEY: Optional. Server-side Pixabay image search
# (api/images/search.ts). When unset, the endpoint returns an explicit
# "not configured" stub payload instead of live results.
# PIXABAY_API_KEY="..."

# RULES_EMULATOR_TESTS: Set to 1 to run the Firestore rules emulator tests
# (firestore.rules.emulator.test.ts), which need a local emulator:
#   bun run rules:emulator
#   RULES_EMULATOR_TESTS=1 bun run test:rules
# Plain `bun test` skips them (see DEPLOYMENT.md).
# RULES_EMULATOR_TESTS="1"

# FIRESTORE_EMULATOR_HOST: Optional. Points the Firebase SDKs at a local Firestore
# emulator during local development (host:port; @firebase/rules-unit-testing
# defaults to 127.0.0.1:5000 when unset).
# FIRESTORE_EMULATOR_HOST="127.0.0.1:5000"
